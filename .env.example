# ===================================================
# FINANCE & EMI COLLECTION CRM - ENVIRONMENT TEMPLATE
# ===================================================

NODE_ENV=development
PORT=4000

# ---------------------------------------------------
# DATABASE (PostgreSQL 16 in Production / Docker)
# ---------------------------------------------------
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://crm_admin:crm_secure_password_2026@localhost:5432/crm_finance_db
# For SQLite local fallback:
# DATABASE_DRIVER=sqlite
# DATABASE_FILE=./data/crm.db

# ---------------------------------------------------
# REDIS (BullMQ Queues & Distributed Locks)
# ---------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------
# AUTHENTICATION & SECURITY (JWT)
# ---------------------------------------------------
JWT_SECRET=replace_with_min_32_char_cryptographically_secure_secret_for_production
JWT_REFRESH_SECRET=replace_with_min_32_char_cryptographically_secure_refresh_secret_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------
# SECURE OBJECT STORAGE / KYC VAULT (AWS S3 / Cloudflare R2)
# ---------------------------------------------------
STORAGE_PROVIDER=local
# For AWS S3 / Cloudflare R2 in staging/production:
# STORAGE_PROVIDER=s3
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_S3_BUCKET=crm-kyc-vault-private
# AWS_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# ---------------------------------------------------
# BUSINESS LOCALIZATION & TIMEZONE
# ---------------------------------------------------
BUSINESS_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------
# CORS & NETWORKING
# ---------------------------------------------------
CORS_ORIGIN=*
