# ==============================================================================
# FINANCE & EMI COLLECTION CRM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the server.
# In Production/Staging: Set all REQUIRED variables with cryptographically secure values.
# NEVER commit production .env files to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & NETWORKING
# ------------------------------------------------------------------------------
# Options: 'development' | 'production' | 'test'
# In production, strict security validations and fail-fast rules are enforced.
NODE_ENV=development

# Backend HTTP service port (default: 4000)
PORT=4000

# Permitted CORS origins for API requests.
# Development: '*' or 'http://localhost:3000'
# Production: Comma-separated list of allowed frontend domains (e.g. 'https://crm.yourcompany.com,https://m.crm.yourcompany.com')
CORS_ORIGIN=*

# Base URL for customer-facing payment portal links generated for SMS/WhatsApp
# Development: 'http://localhost:5173/portal' or 'http://localhost:3000/portal'
# Production: 'https://crm.yourcompany.com/portal'
PORTAL_BASE_URL=http://localhost:5173/portal

# Business timezone for daily EMI transitions, interest calculations, and cutoff timers
BUSINESS_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Driver: 'postgres' (MANDATORY in production; 'sqlite' only allowed in development)
DATABASE_DRIVER=postgres

# PostgreSQL Connection URI: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Production example: postgresql://crm_admin:SECURE_PG_PASSWORD@db-prod.internal:5432/crm_finance_prod
DATABASE_URL=postgresql://crm_admin:crm_secure_password_2026@localhost:5432/crm_finance_db

# Dedicated PostgreSQL Test Database URI (MANDATORY for automated API integration tests when NODE_ENV=test)
# Tests will NEVER touch DATABASE_URL or crm_db and will fail loudly if DATABASE_URL_TEST is unset or points to crm_db.
DATABASE_URL_TEST=postgresql://crm_admin:crm_secure_password_2026@localhost:5432/crm_test_db

# SSL mode for PostgreSQL:
#   For production deployments using Neon or managed PostgreSQL, explicitly set:
#   DATABASE_SSL=true
#   Options:
#   'true'      → Require SSL with full certificate verification (mandatory for Neon / AWS RDS production)
#   'no-verify' → Require SSL but skip cert validation (for managed cloud PaaS without CA certs)
#   'false'     → No SSL (local development and docker network only)
DATABASE_SSL=false

# SQLite fallback path (ONLY applicable when DATABASE_DRIVER=sqlite in local dev)
# DATABASE_FILE=./data/crm.db

# ------------------------------------------------------------------------------
# 3. REDIS (BullMQ Distributed Queues & Atomic Rate-Limiting)
# ------------------------------------------------------------------------------
# Redis connection URI. In production, BullMQ jobs and rate limiters require Redis.
# Development: 'redis://127.0.0.1:6379'
# Production: 'rediss://:<password>@redis-cluster.internal:6380' (TLS enabled)
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (JWT Secrets & Token Lifecycles)
# ------------------------------------------------------------------------------
# Cryptographically secure random secret for signing short-lived Access Tokens (min 32 characters).
# Generate using: openssl rand -base64 32
JWT_SECRET=replace_with_min_32_char_cryptographically_secure_secret_for_production

# Cryptographically secure random secret for signing Refresh Tokens (min 32 characters).
# Generate using: openssl rand -base64 32
JWT_REFRESH_SECRET=replace_with_min_32_char_cryptographically_secure_refresh_secret_2026

# Token expiration windows
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. SECURE OBJECT STORAGE / KYC VAULT (AWS S3 / Cloudflare R2)
# ------------------------------------------------------------------------------
# Storage Provider: 's3' (MANDATORY in production) or 'local' (local disk storage)
STORAGE_PROVIDER=local

# AWS Region where the S3 KYC bucket is provisioned (e.g. 'ap-south-1' for India)
AWS_REGION=ap-south-1

# S3 Private Bucket Name (must have 'Block Public Access' ENABLED)
AWS_S3_BUCKET=crm-kyc-vault-private

# AWS IAM Credentials (REQUIRED in production when STORAGE_PROVIDER=s3)
# Minimum IAM permissions: s3:PutObject, s3:GetObject, s3:DeleteObject, s3:HeadObject
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Optional Custom S3 Endpoint (for Cloudflare R2, MinIO, or Wasabi)
# AWS_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# ------------------------------------------------------------------------------
# 6. EXTERNAL INTEGRATIONS (Google Sheets Export - Optional)
# ------------------------------------------------------------------------------
# Enable automated Google Sheets export for daily collection and overdue ledgers
GOOGLE_SHEETS_ENABLED=false
# GOOGLE_SHEETS_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
# GOOGLE_SERVICE_ACCOUNT_EMAIL=crm-exporter@finance-crm-prod.iam.gserviceaccount.com
# Google Cloud Service Account RSA Private Key (PEM format or escaped single line):
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgI...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 7. FRONTEND / CLIENT-SIDE VARIABLES (Vite Web & Mobile Apps)
# ------------------------------------------------------------------------------
# Used by @crm/web and @crm/mobile build systems.
# Note: In production, client applications can specify a custom API gateway URL:
# VITE_API_BASE_URL=https://api.crm.yourcompany.com/api/v1
# Customer payment support WhatsApp business number:
# VITE_FINANCE_WHATSAPP_NUMBER=919876543210
